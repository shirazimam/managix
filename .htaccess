DirectoryIndex index.php

Options -MultiViews
RewriteEngine On

# Force the production host to the canonical HTTPS www domain.
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^ https://www.managixglobal.com%{REQUEST_URI} [R=301,L,NE]

RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
RewriteCond %{HTTP_HOST} !^www\.managixglobal\.com$ [NC]
RewriteRule ^ https://www.managixglobal.com%{REQUEST_URI} [R=301,L,NE]

# Preserve clean URLs for the section directories.
RewriteRule ^(technology|realestate|digitalmarketing|education)$ %{REQUEST_URI}/ [R=301,L,NE]

# Serve root-level clean PHP pages such as /onboarding.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+?)/?$ $1.php [L,QSA]

# Redirect old root technology URLs into the new /technology section.
RewriteCond %{REQUEST_METHOD} !POST
RewriteCond %{REQUEST_URI} ^(.*/)?(about|services|industries|portfolio|insights|careers|calculator|contact|project-tech-mahindra-maps|project-vajranaad|project-bcims|project-adpc-care|project-krishi-samriddhi-school|project-rhkn-portal|project-megh-mitr|project-sambal|project-emedix|project-school-mobile-applications|project-enterprise-applications)(?:\.php)?/?$ [NC]
RewriteRule ^ %1technology/%2 [R=301,L,NE]

# Keep root index.php clean.
RewriteCond %{REQUEST_METHOD} !POST
RewriteCond %{THE_REQUEST} \s/+index\.php[\s?] [NC]
RewriteCond %{REQUEST_URI} ^(.*/)?index\.php$ [NC]
RewriteRule ^ %1 [R=301,L,NE]
